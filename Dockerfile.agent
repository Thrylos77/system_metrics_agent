# syntax=docker/dockerfile:1

FROM python:3.12-slim-bookworm AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build
COPY requirements.txt .

# pip est retiré du venv à la fin : inutile à l'exécution, et il est scanné par Trivy.
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install -r requirements.txt \
    && /opt/venv/bin/pip uninstall -y pip

FROM python:3.12-slim-bookworm AS runtime

# Change à chaque période (voir workflow) pour invalider le cache de la couche apt
# et récupérer les derniers correctifs de sécurité Debian.
ARG CACHE_BUST=none

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

# procps est requis : l'agent exécute la commande `uptime`.
RUN echo "cache-bust=${CACHE_BUST}" \
    && apt-get update \
    && apt-get upgrade -y \
    && apt-get install --no-install-recommends -y procps \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip uninstall -y pip setuptools wheel \
    && groupadd --system app \
    && useradd --system --gid app --create-home --home-dir /home/app app

WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY app ./app

USER app

CMD ["python", "-m", "app.agent"]